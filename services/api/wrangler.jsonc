// The Worker and its objects. Local development: `bun run dev` (DEV_AUTH comes from .dev.vars, which is ignored).
// Deployed stages live under `env`: `bunx wrangler deploy --env dev` after building the app. Secrets are set by Anton
// with `bunx wrangler secret put <NAME> --env dev`, never here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "work-api",
  "main": "../../packages/server/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ORGANIZATION", "class_name": "OrganizationObject" },
      { "name": "WORKSPACE", "class_name": "WorkspaceObject" },
      { "name": "SESSION", "class_name": "SessionObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrganizationObject", "WorkspaceObject", "SessionObject"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "work-blobs-local" }],
  "vars": {
    "STAGE": "local",
    "PUBLIC_URL": "",
    "WORKOS_CLIENT_ID": "client_local"
  },
  "observability": { "enabled": true },
  "env": {
    // On workers.dev; PUBLIC_URL is empty, so the Worker uses the origin it is called on. Content blobs stay in the EU.
    "dev": {
      "name": "work-api-dev",
      "durable_objects": {
        "bindings": [
          { "name": "ORGANIZATION", "class_name": "OrganizationObject" },
          { "name": "WORKSPACE", "class_name": "WorkspaceObject" },
          { "name": "SESSION", "class_name": "SessionObject" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrganizationObject", "WorkspaceObject", "SessionObject"] }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "work-blobs-dev", "jurisdiction": "eu" }],
      "vars": {
        "STAGE": "dev",
        "PUBLIC_URL": "",
        "WORKOS_CLIENT_ID": "client_01HKAAVJGACQCFB0H4RGX9H50C"
      },
      // The web app. The Worker answers /api and /auth; every other path is the app.
      "assets": {
        "directory": "../../packages/app/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/auth/*"]
      },
      "workers_dev": true,
      "observability": { "enabled": true }
    }
  }
}
